able in both English and Turkish, aiming to equip students with skills relevant to real-world business and technology needs.","user_id":null,"logo_file_id":null,"logo_attachment_id":null,"logo_file_name":null,"profile_image_id":"uz5ml83e5cdf56288421b9480ce27aa79fb91","profile_image_name":"ostim-icon-search.jpg","profile_image_attachment_id":"6421426000013700788"}}
